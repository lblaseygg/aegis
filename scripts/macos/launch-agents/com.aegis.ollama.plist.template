<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aegis.ollama</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>__SUPPORT_DIR__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__OLLAMA_BIN__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__OLLAMA_HOME__</string>
    <key>OLLAMA_HOST</key>
    <string>127.0.0.1:11434</string>
    <key>OLLAMA_MODELS</key>
    <string>__OLLAMA_MODELS__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/ollama.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/ollama.stderr.log</string>
</dict>
</plist>
